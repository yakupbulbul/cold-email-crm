# ============================================================
# Cold Email CRM — Local development environment
# ============================================================
# Copy this file to .env and fill in LOCAL values only.
# Keep real secrets and private endpoints out of git.
# Use your private local setup reference for real values.
# ============================================================

# --- App Runtime ---
APP_ENV=development
FRONTEND_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8050
BACKEND_URL=http://127.0.0.1:8050
NEXT_PUBLIC_API_URL=/api/v1
ALLOWED_ORIGINS=http://localhost:3000
BACKGROUND_WORKERS_ENABLED=false
BACKGROUND_IMAP_SYNC_ENABLED=false

# --- Database / Redis ---
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/cold_email_crm
REDIS_URL=redis://127.0.0.1:6379/0

# --- Security ---
# Generate a strong random local secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=11520
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Google Workspace OAuth Configuration
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=